# 开源数据源原始克隆仓库（体积大，不入版本库，由导入脚本抓取/本地保留）
data_repos/

# 前端依赖/构建产物
frontend/node_modules/
frontend/dist/
frontend/unpackage/
frontend/.hbuilderx/
frontend/.unibuild/

# 后端构建产物
backend/**/target/

# 数据导入产物：核心数据 SQL 入版本库（部署直接可用）；仅忽略超大中间生成的临时分卷
data_import/*.tmp.sql
data_import/full_*/

# 系统
.DS_Store
*.log
# Python 缓存
__pycache__/
*.pyc
data_import/body_parts/
